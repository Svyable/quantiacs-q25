# Quantiacs local/public-data access.
#
# No personal credential is required for local research: the current open-source
# toolbox explicitly accepts the sentinel value `default`, and this repository's
# runner injects it automatically when API_KEY is missing.
#
# Set a real participant API key only for account-bound services such as remote
# participant correlation/precheck/submission. Never commit a real credential.
API_KEY=default
